# Catetin Environment Variables Example
# Jangan memasukkan rahasia nyata ke dalam repositori.

# Worker Secret (Cloudflare Worker):
# Nilai rahasia acak minimal 32 karakter untuk enkripsi session Better Auth
BETTER_AUTH_SECRET="your-32-character-or-longer-random-secret"

# Google OAuth Credentials (Cloudflare Worker secrets):
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Canonical App Origin (contoh: http://localhost:3000 untuk dev, atau https://catetin-project.anwars-rizki.workers.dev untuk prod):
APP_ORIGIN="http://localhost:3000"
