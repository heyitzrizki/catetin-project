    function renderWsWaveform() {
      const container = document.getElementById('ws-waveform');
      const peaks = [25, 48, 75, 38, 88, 62, 92, 42, 28, 60, 85, 90, 48, 70, 35, 82, 95, 62, 30, 46, 76, 88, 52, 32, 72, 85, 50, 72];
      container.innerHTML = peaks.map((p, idx) => {
        const sec = idx * 5;
        const isPast = wsTime >= sec;
        return `
          <div onclick="seekWs(${sec})" class="flex-1 rounded-xs transition-all duration-150 ${isPast ? 'bg-navy-900' : 'bg-slate-300 hover:bg-slate-400'}" style="height:${p}%"></div>
        `;
      }).join('');
      const m = String(Math.floor(wsTime / 60)).padStart(2, '0');
      const s = String(wsTime % 60).padStart(2, '0');
      document.getElementById('ws-time-display').textContent = `${m}:${s} / ${SAMPLES_DATA[activeKey].duration}`;
    }

    function renderWsTranscript() {
      const container = document.getElementById('ws-transcript-feed');
      const list = SAMPLES_DATA[activeKey].dialog;

      container.innerHTML = list.map(item => {
        const isCurrent = wsTime >= item.sec && wsTime < (item.sec + 12);
        return `
          <div class="p-3.5 rounded-sm border transition ${isCurrent ? 'bg-navy-50/70 border-navy-700/60 shadow-2xs' : 'bg-white border-slate-200'}">
            <div class="flex items-center justify-between mb-1.5 font-mono text-[11px]">
              <div class="flex items-center gap-2">
                <button onclick="seekWs(${item.sec})" class="px-2 py-0.5 rounded-xs bg-slate-100 hover:bg-navy-900 hover:text-white transition font-bold text-slate-800 cursor-pointer">
                  ▶ ${item.time}
                </button>
                <span class="font-bold text-navy-950">${item.speaker}</span>
              </div>
              <span class="text-slate-400 text-[10px]">Editable</span>
            </div>
            <p contenteditable="true" class="text-xs sm:text-sm text-slate-800 leading-relaxed focus:outline-none focus:bg-slate-50 p-1 rounded-xs">
              ${item.text}
            </p>
          </div>
        `;
      }).join('');
    }

    function seekWs(sec) {
      wsTime = sec;
      renderWsWaveform();
      renderWsTranscript();
    }

    function toggleWsPlay() {
      if (wsPlaying) {
        stopWsAudio();
      } else {
        wsPlaying = true;
        document.getElementById('ws-play-btn').textContent = '⏸ Jeda Audio';
        wsInterval = setInterval(() => {
          wsTime += 1;
          if (wsTime > SAMPLES_DATA[activeKey].durationSec) wsTime = 0;
          renderWsWaveform();
          renderWsTranscript();
        }, 1000);
      }
    }

    function stopWsAudio() {
      wsPlaying = false;
      clearInterval(wsInterval);
      const btn = document.getElementById('ws-play-btn');
      if (btn) btn.textContent = '▶ Putar Audio';
    }

    function resetWsAudio() {
      wsTime = 0;
      stopWsAudio();
      renderWsWaveform();
      renderWsTranscript();
    }

    function copyFullTranscript() {
      const full = SAMPLES_DATA[activeKey].dialog
        .map(d => `[${d.time}] ${d.speaker}:\n${d.text}`)
        .join('\n\n');
      navigator.clipboard.writeText(full);
      showToast('Seluruh teks berhasil disalin!');
    }

    function exportWordDoc() {
      const full = SAMPLES_DATA[activeKey].dialog
        .map(d => `[${d.time}] ${d.speaker}:\n${d.text}\n`)
        .join('\n');
      const blob = new Blob([full], { type: 'application/msword' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${SAMPLES_DATA[activeKey].filename.split('.')[0]}_transkrip.docx`;
      a.click();
      URL.revokeObjectURL(url);
      showToast('Berkas .DOCX berhasil diunduh!');
    }

    // Inisialisasi awal
    loadSample('wawancara');
  </script>
</body>
</html>